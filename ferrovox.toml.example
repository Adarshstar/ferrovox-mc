# Example configuration. FerroVox generates `ferrovox.toml` with these
# defaults automatically on first run if it doesn't exist yet.

[server]
motd = "A FerroVox Server"
max_players = 100
online_mode = true

[java]
enabled = true
bind = "0.0.0.0"
port = 25565

[bedrock]
enabled = true
bind = "0.0.0.0"
port = 19132

[performance]
# 0 = auto-detect and use all available CPU cores
worker_threads = 0
pin_threads = true
